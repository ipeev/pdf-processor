DOCKER_TELEMETRY_ENABLED=true
DOCKER_TELEMETRY_TOKEN=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MONITOR_ENABLED=true
OPENROUTER_MONITOR_REFRESH_SECONDS=60
NATIVE_PDF_MODEL=inclusionai/ling-3.0-flash-vl
IMAGE_OCR_MODEL=deepseek/deepseek-v4.1-flash-1017
SUMMARY_MODEL=deepseek/deepseek-v4.1-flash-1017
# Fourth extraction option: AI OCR + Pictures (one paid full-mode call per page).
# Defaults are configurable; real model access can incur charges.
VISION_FIGURES_MODEL=anthropic/claude-haiku-5.5
VISION_FIGURES_MAX_TOKENS_PER_PAGE=16000
MAX_VISION_FIGURES_PAGES_PER_DOCUMENT=50
MAX_VISION_FIGURES_PER_PAGE=8
MAX_VISION_ASSET_BYTES=6000000
MAX_VISION_TOTAL_ASSET_BYTES=100000000
# Padding in normalized 0–1000 page coordinates; crop boundaries are best effort.
VISION_FIGURE_PADDING_NORM=20
LOG_FORMAT=json
LOG_LEVEL=INFO
# Grafana browser URL, typically reached through an SSH tunnel on the local computer.
# Leave blank to disable the View in Grafana button; Copy Trace ID remains available.
# The frontend build reads these values. Rebuild frontend if you change them.
GRAFANA_PUBLIC_URL=http://127.0.0.1:3101
GRAFANA_TEMPO_DATASOURCE_UID=tempo
OBSERVABILITY_ENABLED=true
# Traces are pushed over OTLP; container logs are collected by Alloy from Docker.
# Turn on direct OTLP log export only if Docker log collection is disabled.
OBSERVABILITY_LOG_EXPORT_ENABLED=false
OTEL_SERVICE_NAME=pdf-processor
OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4318/v1/traces
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://host.docker.internal:4318/v1/logs
WORKER_THREADS=20
REDIS_URL=redis://redis:6379/0
# Internal Docker-only development service; no host port.
OPENSEARCH_URL=http://opensearch:9200
UPLOAD_DIR=/tmp/pdf-uploads
S3_ENDPOINT_URL=http://rustfs:9000
S3_BUCKET=pdf-uploads
# Permanent storage; must be different from the temporary upload bucket.
S3_ARCHIVE_BUCKET=pdf-documents
S3_ACCESS_KEY=pdfprocessor
S3_SECRET_KEY=local-demo-secret-change-me
S3_LIFECYCLE_DAYS=1
STREAM_KEY=documents:jobs
CONSUMER_GROUP=pdf-workers
CONSUMER_NAME=worker
MAX_FILES_PER_REQUEST=5
MAX_FILE_SIZE_MIB=20
MAX_TOTAL_UPLOAD_MIB=50
MAX_PAGES_PER_DOCUMENT=200
MAX_AI_PAGES_PER_DOCUMENT=200
MAX_SUMMARY_INPUT_CHARS=400000
MAX_AI_OUTPUT_TOKENS_PER_PAGE=32768
MAX_SUMMARY_OUTPUT_TOKENS=4096
OPENROUTER_TIMEOUT_SECONDS=120
OPENROUTER_MAX_CALL_ATTEMPTS=3
MAX_WORKER_ATTEMPTS=3
MAX_RENDER_PIXELS=12000000
MAX_RENDER_IMAGE_BYTES=6000000
RENDER_SCALE=1.5
WORKER_POLL_MS=1000
WORKER_HEARTBEAT_SECONDS=5
WORKER_CLAIM_IDLE_SECONDS=45
RESULT_TTL_SECONDS=86400
CACHE_TTL_SECONDS=86400
RUN_LIVE_TESTS=0
